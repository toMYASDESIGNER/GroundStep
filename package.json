{
  "name": "groundstep",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "It never gives you the next step until reality proves the last one happened.",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node skills/groundstep/scripts/groundstep.mjs serve --port 4190",
    "demo:seed": "node scripts/seed-demo.mjs",
    "demo": "npm run demo:seed && npm start",
    "video:build": "powershell -ExecutionPolicy Bypass -File scripts/make-video.ps1",
    "test": "node --test tests/*.test.mjs",
    "check": "npm test && node skills/groundstep/scripts/groundstep.mjs doctor"
  },
  "devDependencies": {
    "playwright": "^1.61.1"
  }
}
